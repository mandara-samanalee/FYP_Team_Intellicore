# Large data files
# Keep the raw data directory structure in the repo
# and allow specific files to be added when needed.
*.csv
*.json
*.parquet
*.gz

!demo/scripts/df_fusion_scored_sample.csv

!data/raw/.gitkeep
!data/raw/*.csv
!data/raw/*.json
!data/raw/*.parquet
!data/raw/*.gz

# Python
__pycache__/
*.pyc
.env

# Jupyter checkpoints
.ipynb_checkpoints/

# Model weights (too large for GitHub)
*.pt
*.bin
*.h5